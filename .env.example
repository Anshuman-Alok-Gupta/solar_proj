# ============================================================
# AI Solar Intelligence Platform - environment template
# Copy to .env and fill in. Never commit the real .env file.
# ============================================================

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:3000

# Bootstrap admin user (created on first start if it does not exist)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- Database ---
# Local cluster (see HANDOFF.md) or docker compose service "db"
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/solar

# --- GoodWe SEMS (unofficial app/web API, normal SEMS account) ---
# Leave empty until you decide to connect. Credentials stay server-side.
SEMS_ACCOUNT=
SEMS_PASSWORD=
# Optional: fix the plant/station id instead of auto-discovery
SEMS_STATION_ID=
# Polling interval for the scheduled sync (seconds). Minimum enforced: 300.
SEMS_SYNC_INTERVAL_SECONDS=900
# Set to false to disable the scheduled SEMS sync entirely
SEMS_SYNC_ENABLED=false

# --- Weather (Open-Meteo, no key required) ---
WEATHER_SYNC_ENABLED=true
WEATHER_SYNC_INTERVAL_SECONDS=3600

# --- Anthropic Claude (AI Energy Analyst) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Paths ---
MODEL_DIR=./data/models
UPLOAD_DIR=./data/uploads

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- AI Energy Analyst LLM (provider-agnostic; any OpenAI-compatible API) ---
# Examples: Groq https://api.groq.com/openai/v1 | OpenRouter https://openrouter.ai/api/v1
#           Gemini https://generativelanguage.googleapis.com/v1beta/openai | Ollama http://localhost:11434/v1
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-flash-latest
# auto = use function calling, fall back to backend context injection if the model lacks it
LLM_TOOL_MODE=auto
